@{
    ViewData["Title"] = "Poradniki Strzeleckie";
}

<div class="container my-5">
    <h1 class="mb-4">Poradniki i Baza Wiedzy</h1>
    
    <div class="alert alert-secondary border-start border-4 border-warning" role="alert">
        <h4 class="alert-heading">Bezpieczeństwo przede wszystkim!</h4>
        <p>Pamiętaj o czterech podstawowych zasadach bezpieczeństwa. Zawsze traktuj broń tak, jakby była załadowana.</p>
    </div>

    <div class="list-group shadow-sm mt-4">
        <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">
            <i class="bi bi-shield-check fs-3 text-success"></i>
            <div class="d-flex gap-2 w-100 justify-content-between">
                <div>
                    <h6 class="mb-0">Jak uzyskać pozwolenie na broń w 2026 roku?</h6>
                    <p class="mb-0 opacity-75">Koszty, wymagania i badania lekarskie krok po kroku.</p>
                </div>
                <small class="opacity-50 text-nowrap">Nowość</small>
            </div>
        </a>
        <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">
            <i class="bi bi-crosshair fs-3 text-danger"></i>
            <div class="d-flex gap-2 w-100 justify-content-between">
                <div>
                    <h6 class="mb-0">Prawidłowy chwyt pistoletu</h6>
                    <p class="mb-0 opacity-75">Najczęstsze błędy początkujących i jak ich unikać na strzelnicy.</p>
                </div>
            </div>
        </a>
        <a href="#" class="list-group-item list-group-item-action d-flex gap-3 py-3" aria-current="true">
            <i class="bi bi-tools fs-3 text-secondary"></i>
            <div class="d-flex gap-2 w-100 justify-content-between">
                <div>
                    <h6 class="mb-0">Czyszczenie i konserwacja</h6>
                    <p class="mb-0 opacity-75">Jakiej chemii używać, aby nie uszkodzić oksydy i mechanizmów.</p>
                </div>
            </div>
        </a>
    </div>
</div>