@{
    ViewData["Title"] = "Najnowsze Artykuły";
}

<div class="container my-5">
    <h1 class="mb-4 border-bottom pb-2">Najnowsze Wpisy</h1>

    <div class="row row-cols-1 row-cols-md-2 g-4">
        
        <!-- Przykładowy wpis -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1581955957646-b5a446b6100a?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MjAxN3wwfDF8c2VhcmNofDJ8fGdsb2NrMTh8ZW58MHx8fHwxNzgwMDU1NjA0fDA&ixlib=rb-4.1.0&q=85&q=85&fmt=jpg&crop=entropy&cs=tinysrgb&w=450" class="card-img-top h-75" alt="Pistolet Glock">
                <div class="card-body">
                    <h5 class="card-title">Glock 19 vs CZ P-10C - Co wybrać na start?</h5>
                    <p class="card-text">Porównujemy dwa najpopularniejsze pistolety bijnikowe na polskim rynku. Który sprawdzi się lepiej dla początkującego strzelca?</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a href="#" class="btn btn-primary w-100">Czytaj dalej</a>
                </div>
            </div>
        </div>

        <!-- Przykładowy wpis -->
        <div class="col">
            <div class="card h-100 shadow-sm">
                <img src="https://images.unsplash.com/photo-1610057999337-08c0d3df6081?crop=entropy&cs=srgb&fm=jpg&ixid=M3w3MjAxN3wwfDF8c2VhcmNofDExfHxhcjE1fGVufDB8fHx8MTc4MDA1NTU4M3ww&ixlib=rb-4.1.0&q=85&q=85&fmt=jpg&crop=entropy&cs=tinysrgb&w=450" class="card-img-top h-75" alt="Karabin AR-15">
                <div class="card-body">
                    <h5 class="card-title">AR-15 - Poradnik składania</h5>
                    <p class="card-text">Krok po kroku pokazujemy, jak złożyć swój własny karabinek platformy AR z wybranych przez siebie części.</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <a href="#" class="btn btn-primary w-100">Czytaj dalej</a>
                </div>
            </div>
        </div>
        
    </div>
</div>