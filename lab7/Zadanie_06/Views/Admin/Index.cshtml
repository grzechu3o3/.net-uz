@model List<Zadanie_06.Models.NewsItem>

@{
    ViewData["Title"] = "Panel admina";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center">
        <h3>Panel admina</h3>
        <a asp-action="Logout" class="btn btn-outline-danger btn-sm">Wyloguj</a>
    </div>
    <hr />

    <h5>Dodaj wiadomość</h5>
    <form asp-action="Add" method="post" class="mb-4">
        @Html.AntiForgeryToken()
        <div class="mb-2">
            <input type="text" name="title" class="form-control" placeholder="Tytuł" required />
        </div>
        <div class="mb-2">
            <textarea name="content" class="form-control" rows="3" placeholder="Treść" required></textarea>
        </div>
        <button type="submit" class="btn btn-success">Dodaj</button>
    </form>

    <h5>Opublikowane wiadomości</h5>
    @foreach (var item in Model)
    {
        <div class="card mb-2">
            <div class="card-body d-flex justify-content-between align-items-start">
                <div>
                    <strong>@item.Title</strong>
                    <p class="mb-0 text-muted">@item.Content</p>
                    <small class="text-muted">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
                <form asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" value="@item.Id" />
                    <button type="submit" class="btn btn-danger btn-sm">Usuń</button>
                </form>
            </div>
        </div>
    }
</div>