@model List<Zadanie_06.Models.NewsItem>

@{
    ViewData["Title"] = "Aktualności";
}

<div class="container mt-4">
    <h2>Wiadomości z ostatniej chwili</h2>
    <hr />

    @if (!Model.Any())
    {
        <p class="text-muted">Brak wiadomości.</p>
    }
    else
    {
        @foreach (var item in Model)
        {
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="card-title">@item.Title</h5>
                    <p class="card-text">@item.Content</p>
                    <small class="text-muted">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                </div>
            </div>
        }
    }

    <a asp-controller="Admin" asp-action="Login" class="btn btn-sm btn-outline-secondary mt-3">
        Panel admina
    </a>
</div>