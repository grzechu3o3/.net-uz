@model Zadanie_07.Models.UploadViewModel

@{
    ViewData["Title"] = "Wgraj pliki";
}

<div class="container mt-5" style="max-width: 600px;">
    <h2>📁 Wgraj pliki na serwer</h2>
    <p class="text-muted">Możesz wgrać wiele plików jednocześnie. Maksymalny rozmiar: 100 MB.</p>
    <hr />
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <div>@error.ErrorMessage</div>
            }
        </div>
    }
    <div class="mt-3 text-center">
        <a asp-action="Files" class="btn btn-outline-secondary">📂 Przeglądaj wgrane pliki</a>
    </div>

    <form asp-action="Index" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="Files" class="form-label fw-bold"></label>

            <input type="file" name="Files" multiple class="form-control" />
            <span asp-validation-for="Files" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary w-100">
            ⬆️ Wgraj
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}